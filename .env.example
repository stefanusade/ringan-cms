# Salin file ini menjadi .env lalu sesuaikan
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Biarkan kosong untuk auto-detect (http://host). Isi jika dipasang di sub-folder.
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ringan_cms
DB_USER=ringan_cms
DB_PASS=change-this
DB_CHARSET=utf8mb4

# Secret untuk JWT — WAJIB diganti dengan string acak panjang di produksi
JWT_SECRET=change-me-with-a-long-random-string
JWT_TTL=3600

# Rate limiting login (percobaan / menit penguncian)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Rate limiting API (request / detik window)
API_RATE_LIMIT=120
API_RATE_WINDOW=60

# Origin CORS yang diizinkan (dipisah koma). Kosong = same-origin only.
CORS_ORIGINS=

# Ukuran maks upload dalam byte (default 5MB)
MAX_UPLOAD_SIZE=5242880

# Media: kompresi & offload S3/R2 (opsional — override setting DB; lebih aman
# untuk secret). Baca juga di Settings > Media.
# MEDIA_COMPRESS=true
# MEDIA_MAX_WIDTH=1920
# MEDIA_QUALITY=82
# MEDIA_OFFLOAD=false
# MEDIA_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_REGION=auto
# MEDIA_BUCKET=ringan-cms-media
# MEDIA_ACCESS_KEY=xxx
# MEDIA_SECRET_KEY=xxx
# MEDIA_KEEP_LOCAL=true
# MEDIA_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# Opsional untuk installer non-interaktif
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
